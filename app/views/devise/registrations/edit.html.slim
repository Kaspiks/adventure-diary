- content_for(:title) { "Edit Profile | Adventure Diary" }

.container.mx-auto.px-4.py-8.max-w-2xl
  h1.text-2xl.font-bold.text-gray-900.mb-6 Edit Profile

  .bg-white.rounded-lg.shadow.p-6
    = form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f|
      = render "devise/shared/error_messages", resource: resource

      .space-y-4
        .grid.grid-cols-2.gap-4
          div
            = f.label :first_name, class: "block text-sm font-medium text-gray-700"
            = f.text_field :first_name, autofocus: true, autocomplete: "given-name", required: true, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"

          div
            = f.label :last_name, class: "block text-sm font-medium text-gray-700"
            = f.text_field :last_name, autocomplete: "family-name", required: true, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"

        div
          = f.label :email, class: "block text-sm font-medium text-gray-700"
          = f.email_field :email, autocomplete: "email", required: true, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"

        hr.my-6

        h3.text-lg.font-medium.text-gray-900 Change Password
        p.text-sm.text-gray-500.mb-4 Leave blank if you don't want to change it

        div
          = f.label :password, "New password", class: "block text-sm font-medium text-gray-700"
          - if @minimum_password_length
            em.text-xs.text-gray-500 (#{@minimum_password_length} characters minimum)
          = f.password_field :password, autocomplete: "new-password", class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"

        div
          = f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-700"
          = f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"

        hr.my-6

        div
          = f.label :current_password, class: "block text-sm font-medium text-gray-700"
          em.text-xs.text-gray-500 (required to confirm changes)
          = f.password_field :current_password, autocomplete: "current-password", required: true, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"

      .flex.justify-between.items-center.pt-4
        = f.submit "Update", class: "inline-flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer"

        = link_to "Back", root_path, class: "text-sm text-gray-600 hover:text-gray-900"

  .mt-8.bg-red-50.rounded-lg.p-6
    h3.text-lg.font-medium.text-red-900 Danger Zone
    p.text-sm.text-red-600.mt-2 Once you delete your account, there is no going back.

    .mt-4
      = button_to "Delete my account", registration_path(resource_name), data: { confirm: "Are you sure you want to delete your account? This cannot be undone.", turbo_confirm: "Are you sure you want to delete your account? This cannot be undone." }, method: :delete, class: "inline-flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 cursor-pointer"



