- content_for :title, t('.title')

.min-h-screen class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900"
  nav.border-b.sticky.top-0.z-50 class="border-white/10 bg-slate-900/50 backdrop-blur-xl"
    .max-w-2xl.mx-auto.px-4.sm:px-6.lg:px-8
      .flex.items-center.justify-between.h-16
        .flex.items-center.gap-3
          = link_to profile_path, class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-700 transition-colors" do
            svg.w-5.h-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
              path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"
          h1.text-xl.font-bold.text-white = t('.title')

  .max-w-2xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8
    = simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f|
      - if resource.errors.any?
        .rounded-xl.border.p-4.mb-6 class="bg-red-500/10 border-red-500/30"
          .flex.items-start.gap-3
            svg.w-5.h-5.text-red-400.flex-shrink-0.mt-0.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
              path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"
            div
              p.font-medium.text-red-300 = t('errors.messages.not_saved', count: resource.errors.count, resource: resource.class.model_name.human.downcase)
              ul.mt-2.text-sm.text-red-300.space-y-1.list-disc.list-inside
                - resource.errors.full_messages.each do |message|
                  li = message

      .rounded-2xl.border.p-6 class="bg-slate-800/50 border-white/10"
        h3.text-lg.font-semibold.text-white.mb-4 = t('.sections.personal_info')
        
        .grid.gap-4 class="sm:grid-cols-2"
          div
            = f.input :first_name,
              label: t('.first_name'),
              required: true,
              autofocus: true,
              label_html: { class: "block text-sm font-medium text-slate-300 mb-1" },
              input_html: { class: "w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" }

          div
            = f.input :last_name,
              label: t('.last_name'),
              required: true,
              label_html: { class: "block text-sm font-medium text-slate-300 mb-1" },
              input_html: { class: "w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" }

        .mt-4
          = f.input :email,
            label: t('.email'),
            required: true,
            label_html: { class: "block text-sm font-medium text-slate-300 mb-1" },
            input_html: { class: "w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" }

      .rounded-2xl.border.p-6 class="bg-slate-800/50 border-white/10"
        h3.text-lg.font-semibold.text-white.mb-2 = t('.sections.change_password')
        p.text-sm.text-slate-400.mb-4 = t('.leave_blank_hint')
        
        .grid.gap-4 class="sm:grid-cols-2"
          div
            = f.input :password,
              label: t('.new_password'),
              required: false,
              hint: (@minimum_password_length ? t('.password_hint', min_length: @minimum_password_length) : nil),
              label_html: { class: "block text-sm font-medium text-slate-300 mb-1" },
              hint_html: { class: "text-xs text-slate-400 mt-1" },
              input_html: { class: "w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent", autocomplete: "new-password" }

          div
            = f.input :password_confirmation,
              label: t('.password_confirmation'),
              required: false,
              label_html: { class: "block text-sm font-medium text-slate-300 mb-1" },
              input_html: { class: "w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent", autocomplete: "new-password" }

      .rounded-2xl.border.p-6 class="bg-slate-800/50 border-white/10"
        h3.text-lg.font-semibold.text-white.mb-2 = t('.sections.confirm_changes')
        p.text-sm.text-slate-400.mb-4 = t('.current_password_hint')
        
        = f.input :current_password,
          label: t('.current_password'),
          required: true,
          label_html: { class: "block text-sm font-medium text-slate-300 mb-1" },
          input_html: { class: "w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent", autocomplete: "current-password" }

      .flex.justify-between.items-center.pt-2
        = f.submit t('.submit'), class: "px-6 py-2 rounded-lg font-medium text-white cursor-pointer transition-all duration-200 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 shadow-lg shadow-emerald-500/25"
        = link_to t('.cancel'), profile_path, class: "px-4 py-2 rounded-lg font-medium text-slate-300 transition-colors hover:text-white hover:bg-slate-700"

      .rounded-2xl.border.p-6.mt-6 class="bg-red-500/10 border-red-500/30"
        h3.text-lg.font-semibold.text-red-300.mb-2 = t('.danger_zone.title')
        p.text-sm.text-red-300/70.mb-4 = t('.danger_zone.warning')
        
        = button_to t('.danger_zone.delete_account'), registration_path(resource_name), method: :delete, data: { turbo_confirm: t('.danger_zone.confirm') }, class: "px-4 py-2 rounded-lg font-medium text-white cursor-pointer transition-colors bg-red-600 hover:bg-red-500"
