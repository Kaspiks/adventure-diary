- if resource.errors.any?
  .mb-6.p-4.rounded-xl.border class="bg-red-500/20 border-red-400/30"
    .flex.items-start.gap-3
      svg.w-5.h-5.text-red-300.flex-shrink-0.mt-0.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
        path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"
      div
        h3.text-sm.font-medium.text-red-200
          = t('errors.messages.not_saved', count: resource.errors.count, resource: resource.class.model_name.human.downcase)
        ul.mt-2.text-sm.text-red-300.list-disc.list-inside.space-y-1
          - resource.errors.full_messages.each do |message|
            li = message
