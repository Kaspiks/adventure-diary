.max-w-7xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8
  .grid.grid-cols-2.lg:grid-cols-4.gap-4.mb-8
    .rounded-xl.p-5.border class="bg-gradient-to-br from-amber-500/10 to-orange-500/10 border-amber-500/20"
      .flex.items-center.justify-between
        div
          p.text-sm.text-amber-200 = @presenter.stats_labels[:points]
          p.text-2xl.font-bold.text-white = @presenter.stats[:points]
        .w-12.h-12.rounded-full.flex.items-center.justify-center class="bg-amber-500/20"
          = icon "star", class: "w-6 h-6 text-amber-400"

    .rounded-xl.p-5.border class="bg-gradient-to-br from-emerald-500/10 to-teal-500/10 border-emerald-500/20"
      .flex.items-center.justify-between
        div
          p.text-sm.text-emerald-200 = @presenter.stats_labels[:active]
          p.text-2xl.font-bold.text-white = @presenter.stats[:challenges_active]
        .w-12.h-12.rounded-full.flex.items-center.justify-center class="bg-emerald-500/20"
          = icon "clock", class: "w-6 h-6 text-emerald-400"

    .rounded-xl.p-5.border class="bg-gradient-to-br from-cyan-500/10 to-blue-500/10 border-cyan-500/20"
      .flex.items-center.justify-between
        div
          p.text-sm.text-cyan-200 = @presenter.stats_labels[:completed]
          p.text-2xl.font-bold.text-white = @presenter.stats[:challenges_completed]
        .w-12.h-12.rounded-full.flex.items-center.justify-center class="bg-cyan-500/20"
          = icon "check", class: "w-6 h-6 text-cyan-400"

    .rounded-xl.p-5.border class="bg-gradient-to-br from-purple-500/10 to-pink-500/10 border-purple-500/20"
      .flex.items-center.justify-between
        div
          p.text-sm.text-purple-200 = @presenter.stats_labels[:rewards]
          p.text-2xl.font-bold.text-white = @presenter.stats[:rewards_claimed]
        .w-12.h-12.rounded-full.flex.items-center.justify-center class="bg-purple-500/20"
          = icon "star", class: "w-6 h-6 text-purple-400"

  .grid.lg:grid-cols-3.gap-6
    .lg:col-span-2.space-y-6
      .rounded-2xl.border.p-6 class="bg-slate-800/50 border-white/10"
        .flex.items-center.justify-between.mb-4
          h2.text-lg.font-semibold.text-white = @presenter.section_titles[:active_challenges]
          = link_to challenges_path, class: "text-sm text-amber-400 hover:text-amber-300" do
            = @presenter.view_all_text
        
        - if @presenter.active_challenges.any?
          .space-y-3
            - @presenter.active_challenges.each do |challenge|
              = link_to challenge_path(challenge), class: "block p-4 rounded-xl transition-all hover:bg-white/5 group border border-transparent hover:border-white/10" do
                .flex.items-center.justify-between
                  .flex.items-center.gap-3
                    .w-10.h-10.rounded-lg.flex.items-center.justify-center class="bg-emerald-500/20"
                      = icon "map-pin", class: "w-5 h-5 text-emerald-400"
                    div
                      .text-white.font-medium.group-hover:text-emerald-400.transition-colors = challenge.title
                      .text-xs.text-slate-400 = challenge.challenge_type&.name
                  .flex.items-center.gap-2
                    span.text-sm.font-semibold.text-amber-400 +#{challenge.award_points}
                    = icon "chevron-right", class: "w-4 h-4 text-slate-500 group-hover:text-white transition-colors"
        - else
          .text-center.py-8
            = icon "map-pin", class: "w-12 h-12 text-slate-600 mx-auto mb-3"
            p.text-slate-400.mb-4 = @presenter.empty_state_messages[:no_challenges]
            = link_to challenges_path, class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-white transition-all bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400" do
              = icon "plus", class: "w-4 h-4"
              = @presenter.empty_state_messages[:browse_challenges]

      .rounded-2xl.border.p-6 class="bg-slate-800/50 border-white/10"
        .flex.items-center.justify-between.mb-4
          h2.text-lg.font-semibold.text-white = @presenter.section_titles[:recent_activity]
        
        - if @presenter.recent_activity.any?
          .space-y-3
            - @presenter.recent_activity.each do |attempt|
              = link_to attempt_path(attempt), class: "block p-4 rounded-xl transition-all hover:bg-white/5 group" do
                .flex.items-center.gap-4
                  .w-10.h-10.rounded-full.flex.items-center.justify-center class="bg-#{attempt.attempt_status&.code == 'approved' ? 'emerald' : attempt.attempt_status&.code == 'rejected' ? 'red' : attempt.attempt_status&.code == 'submitted' ? 'amber' : 'blue'}-500/20"
                    - if attempt.approved?
                      = icon "check", class: "w-5 h-5 text-emerald-400"
                    - elsif attempt.rejected?
                      = icon "x", class: "w-5 h-5 text-red-400"
                    - elsif attempt.submitted?
                      = icon "clock", class: "w-5 h-5 text-amber-400"
                    - else
                      = icon "arrow-right", class: "w-5 h-5 text-blue-400"
                  div.flex-1.min-w-0
                    .text-white.font-medium.truncate.group-hover:text-emerald-400.transition-colors = attempt.challenge&.title
                    .flex.items-center.gap-2.mt-1
                      span class="text-xs px-2 py-0.5 rounded-full bg-#{attempt.attempt_status&.code == 'approved' ? 'emerald' : attempt.attempt_status&.code == 'rejected' ? 'red' : attempt.attempt_status&.code == 'submitted' ? 'amber' : 'blue'}-500/20 text-#{attempt.attempt_status&.code == 'approved' ? 'emerald' : attempt.attempt_status&.code == 'rejected' ? 'red' : attempt.attempt_status&.code == 'submitted' ? 'amber' : 'blue'}-300"
                        = attempt.attempt_status&.name
                      span.text-xs.text-slate-500 = time_ago_in_words(attempt.started_at) + " ago"
                  - if attempt.score_awarded && attempt.score_awarded > 0
                    span.text-sm.font-semibold.text-emerald-400 +#{attempt.score_awarded}
        - else
          .text-center.py-8
            = icon "clock", class: "w-12 h-12 text-slate-600 mx-auto mb-3"
            p.text-slate-400 = @presenter.empty_state_messages[:no_activity]

    .space-y-6
      .rounded-2xl.border.p-6 class="bg-slate-800/50 border-white/10"
        h2.text-lg.font-semibold.text-white.mb-4 = @presenter.section_titles[:quick_actions]
        .space-y-2
          - @presenter.quick_actions.each do |action|
            = link_to action.url, class: "flex items-center gap-3 p-3 rounded-xl transition-all hover:bg-white/5 group" do
              .w-10.h-10.rounded-lg.flex.items-center.justify-center class="#{action.bg_color_class}"
                = icon action.icon, width: 20, height: 20, class: action.icon_color_class
              div
                .text-slate-300.group-hover:text-white.font-medium = action.title
                .text-xs.text-slate-500 = action.description
        
        - if @presenter.admin_quick_actions.any?
          .border-t.mt-4.pt-4 class="border-slate-700"
            .text-xs.font-medium.text-slate-500.uppercase.tracking-wider.mb-3 Admin
            .space-y-2
              - @presenter.admin_quick_actions.each do |action|
                = link_to action.url, class: "flex items-center gap-3 p-3 rounded-xl transition-all hover:bg-white/5 group" do
                  .w-10.h-10.rounded-lg.flex.items-center.justify-center class="#{action.bg_color_class}"
                    = icon action.icon, width: 20, height: 20, class: action.icon_color_class
                  div
                    .text-slate-300.group-hover:text-white.font-medium = action.title
                    .text-xs.text-slate-500 = action.description

      .rounded-2xl.border.p-6 class="bg-slate-800/50 border-white/10"
        .flex.items-center.justify-between.mb-4
          h2.text-lg.font-semibold.text-white = @presenter.section_titles[:leaderboard]
        
        - if @presenter.leaderboard.any?
          .space-y-2
            - @presenter.leaderboard.each_with_index do |user, index|
              .flex.items-center.gap-3.p-3.rounded-xl class="#{index == 0 ? 'bg-amber-500/10' : 'hover:bg-white/5'}"
                .w-8.h-8.rounded-full.flex.items-center.justify-center.text-sm.font-bold class="#{index == 0 ? 'bg-amber-500 text-white' : index == 1 ? 'bg-slate-400 text-white' : index == 2 ? 'bg-amber-700 text-white' : 'bg-slate-700 text-slate-400'}"
                  = index + 1
                .w-8.h-8.rounded-full.flex.items-center.justify-center.text-sm.font-semibold class="bg-gradient-to-br from-emerald-500 to-teal-500 text-white"
                  = user.initials
                .flex-1.min-w-0
                  .text-sm.font-medium.text-white.truncate = user.full_name
                .flex.items-center.gap-1
                  = icon "star", class: "w-4 h-4 text-amber-400"
                  span.text-sm.font-semibold.text-amber-400 = user.reward_points
        - else
          .text-center.py-6
            = icon "award", class: "w-10 h-10 text-slate-600 mx-auto mb-2"
            p.text-sm.text-slate-500 = @presenter.empty_state_messages[:no_leaderboard]
