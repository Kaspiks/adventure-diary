doctype html
html
  head
    title = "#{t('admin.title')} | #{content_for(:title) || t('admin.dashboard.title')}"
    meta name="viewport" content="width=device-width,initial-scale=1"
    = csrf_meta_tags
    = csp_meta_tag
    script src="https://cdn.tailwindcss.com"
    = stylesheet_link_tag "icons", "data-turbo-track": "reload"
    link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""
    = stylesheet_link_tag "leaflet", "data-turbo-track": "reload"
    script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""
    = javascript_importmap_tags

  body.min-h-screen.bg-slate-900 data-controller="admin-sidebar"
    = render_svg_icons

    / Mobile header
    .lg:hidden.sticky.top-0.z-50.flex.items-center.justify-between.h-14.px-4.border-b class="bg-slate-800 border-slate-700"
      .flex.items-center.gap-3
        .w-8.h-8.rounded-lg.flex.items-center.justify-center class="bg-gradient-to-br from-red-500 to-rose-600"
          = icon "file", class: "w-4 h-4 text-white"
        span.font-bold.text-white.text-sm = t('admin.title')
      button.p-2.rounded-lg.text-slate-400.hover:text-white.hover:bg-slate-700.transition-colors type="button" data-action="click->admin-sidebar#toggle"
        = icon "menu-2", class: "w-6 h-6"

    / Mobile sidebar overlay
    .fixed.inset-0.z-40.lg:hidden.hidden data-admin-sidebar-target="overlay" data-action="click->admin-sidebar#close"
      .absolute.inset-0.bg-black/50

    / Sidebar - always fixed, hidden on mobile by default
    aside.fixed.inset-y-0.left-0.z-40.w-64.border-r.flex.flex-col.transform.-translate-x-full.lg:translate-x-0.transition-transform.duration-200 class="bg-slate-800 border-slate-700" data-admin-sidebar-target="sidebar"
      .p-4.border-b class="border-slate-700"
        .flex.items-center.justify-between
          .flex.items-center.gap-3
            .w-10.h-10.rounded-lg.flex.items-center.justify-center class="bg-gradient-to-br from-red-500 to-rose-600"
              = icon "file", class: "w-6 h-6 text-white"
            div
              p.font-bold.text-white = t('admin.title')
              p.text-xs.text-slate-400 = t('admin.subtitle')
          / Mobile close button
          button.lg:hidden.p-2.rounded-lg.text-slate-400.hover:text-white.hover:bg-slate-700.transition-colors type="button" data-action="click->admin-sidebar#close"
            = icon "x", class: "w-5 h-5"

      nav.flex-1.p-4.overflow-y-auto
        - admin_navigation_presenter.navigation_sections.each do |section|
          - if section.title.present?
            .mt-6.mb-2.px-3
              p.text-xs.font-semibold.uppercase.tracking-wider.text-slate-500 = section.title
          .space-y-1
            - section.items.each do |item|
              = link_to item.url, class: "flex items-center gap-3 px-3 py-2 rounded-lg transition-colors #{item.active? ? 'bg-slate-700 text-white' : 'text-slate-400 hover:text-white hover:bg-slate-700/50'}", data: { action: "click->admin-sidebar#close" } do
                = icon(item.icon, width: 20, height: 20)
                span = item.title

      .p-4.border-t class="border-slate-700"
        .flex.items-center.gap-3.mb-3
          .w-10.h-10.rounded-full.flex.items-center.justify-center.text-sm.font-medium.text-white class="bg-gradient-to-br from-amber-400 to-orange-500"
            = current_user.initials
          div.min-w-0
            p.text-sm.font-medium.text-white.truncate = current_user.full_name
            p.text-xs.text-slate-400 = t('admin.role')

        .flex.gap-2
          = link_to root_path, class: "flex-1 flex items-center justify-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-700/50 transition-colors" do
            = icon "arrow-left", class: "w-4 h-4"
            span.hidden.sm:inline = t('admin.back_to_app')

          = link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "flex items-center justify-center px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-700/50 transition-colors" do
            = icon "logout", class: "w-4 h-4"

    / Main content - offset on desktop to account for fixed sidebar
    main.lg:ml-64.min-h-screen
      .p-4.sm:p-6.lg:p-8
        - if flash[:notice]
          .mb-6.p-4.rounded-lg.text-sm class="bg-emerald-500/20 text-emerald-200 border border-emerald-500/30"
            = flash[:notice]
        - if flash[:alert]
          .mb-6.p-4.rounded-lg.text-sm class="bg-red-500/20 text-red-200 border border-red-500/30"
            = flash[:alert]

        = yield