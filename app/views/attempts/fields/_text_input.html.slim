/ Text Input field for attempt submission
/
/ Local variables:
/   field   - The template field object
/   attempt - The challenge attempt object
/   f       - The form builder (optional)

- answer = attempt.answer_for_field(field.id)
- current_value = answer&.answer_value

= text_field_tag "attempts_submit_actions_form[answers][#{field.id}]", current_value, required: field.required?, class: "w-full px-4 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors", placeholder: t('attempts.fields.text_input.placeholder', default: 'Enter your answer')
