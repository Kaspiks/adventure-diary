/ Multiple Choice field for attempt submission
/
/ Local variables:
/   field   - The template field object
/   attempt - The challenge attempt object

- answer = attempt.answer_for_field(field.id)
- selected_values = answer&.answer_value_array || []
- options = field.config[:options] || []

.space-y-2
  - options.each do |option|
    .flex.items-center.gap-3.p-2.rounded-lg.transition-colors class="hover:bg-slate-700/50"
      = check_box_tag "attempts_submit_actions_form[answers][#{field.id}][]", option, selected_values.include?(option), class: "w-4 h-4 rounded text-emerald-500 bg-slate-700 border-slate-600 focus:ring-emerald-500 focus:ring-offset-slate-800"
      = label_tag "attempts_submit_actions_form_answers_#{field.id}_#{option.parameterize}", option, class: "text-sm text-slate-300 cursor-pointer flex-1"

p.text-xs.text-slate-400.mt-2
  = t('attempts.fields.multiple_choice.hint', default: 'Select all that apply')
