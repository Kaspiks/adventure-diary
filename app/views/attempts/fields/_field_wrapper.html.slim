/ Field wrapper for attempt form fields
/
/ Local variables:
/   field   - The template field object
/   attempt - The challenge attempt object
/
/ This partial wraps field-specific partials with common elements:
/   - Label
/   - Instructions
/   - The field-specific partial

.space-y-2.mb-4
  / Label
  = label_tag "attempts_submit_actions_form[answers][#{field.id}]", class: "block text-sm font-medium text-slate-300" do
    = field.label
    - if field.required?
      span.text-red-400.ml-1 *

  / Instructions
  - if field.instructions.present?
    p.text-xs.text-slate-400.mb-2 = field.instructions

  / Points (if applicable)
  - if field.points.to_i > 0
    .inline-flex.items-center.gap-1.px-2.py-0.5.rounded-full.text-xs.font-medium.mb-2 class="bg-emerald-500/20 text-emerald-300"
      svg.w-3.h-3 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
        path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z" clip-rule="evenodd"
      = t('attempts.fields.points', count: field.points, default: "#{field.points} points")

  / Render field-specific partial
  = render "attempts/fields/#{field.type}", field: field, attempt: attempt
