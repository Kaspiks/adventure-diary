- content_for :title, t('.title')

.min-h-screen.bg-slate-900.py-8
  .max-w-4xl.mx-auto.px-4
    = link_to my_attempts_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-white mb-4" do
      svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
        path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"
      = t('.back')

    .rounded-xl.border.overflow-hidden class="bg-slate-800/50 border-slate-700"
      .p-8
        .flex.items-start.justify-between.mb-6
          div
            h1.text-2xl.font-bold.text-white.mb-2 = @presenter.decorated_attempt.challenge_title
            span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-#{@presenter.decorated_attempt.status_color}-500/20 text-#{@presenter.decorated_attempt.status_color}-300"
              = @presenter.decorated_attempt.status_name
          - if @presenter.decorated_attempt.score_awarded
            .text-right
              .text-3xl.font-bold.text-emerald-400 +#{@presenter.decorated_attempt.score_awarded}
              .text-sm.text-slate-400 = t('.points_earned')
              - if @presenter.decorated_attempt.object.challenge.has_fields? && @presenter.decorated_attempt.object.response_results.any?
                - max_score = @presenter.decorated_attempt.object.challenge.total_field_points
                - field_score = @presenter.decorated_attempt.object.calculate_score
                .text-xs.text-slate-500.mt-1
                  = "Quiz Score: #{field_score}/#{max_score}"

        .grid.grid-cols-2.gap-6.mb-6
          div
            .text-sm.text-slate-400.mb-1 = t('.fields.started')
            .text-white = @presenter.decorated_attempt.started_at_formatted
          div
            .text-sm.text-slate-400.mb-1 = t('.fields.submitted')
            .text-white = @presenter.decorated_attempt.submitted_at_formatted || "-"
          - if @presenter.decorated_attempt.reviewed_at
            div
              .text-sm.text-slate-400.mb-1 = t('.fields.reviewed')
              .text-white = @presenter.decorated_attempt.reviewed_at_formatted
            div
              .text-sm.text-slate-400.mb-1 = t('.fields.reviewer')
              .text-white = @presenter.decorated_attempt.reviewer_name

        - if @presenter.decorated_attempt.evidence_url.present?
          .mb-6
            .text-sm.text-slate-400.mb-1 = t('.fields.evidence')
            = link_to @presenter.decorated_attempt.evidence_url, @presenter.decorated_attempt.evidence_url, target: "_blank", class: "text-emerald-400 hover:text-emerald-300 break-all"

        - if @presenter.can_submit?
          .border-t.pt-6 class="border-slate-700"
            h2.text-lg.font-semibold.text-white.mb-4 = t('.submit_evidence')
            = form_with url: submit_attempt_path(@presenter.decorated_attempt), method: :patch, local: true, multipart: true, class: "space-y-6" do |f|
              - challenge = @presenter.decorated_attempt.object.challenge
              - challenge.fields.each do |field|
                .space-y-2
                  = label_tag "answers[#{field.id}]", field.label, class: "block text-sm font-medium text-slate-300"
                  - if field.instructions.present?
                    p.text-xs.text-slate-400.mb-2 = field.instructions
                  
                  - case field.type
                  - when "text_input"
                    = text_field_tag "answers[#{field.id}]", @presenter.decorated_attempt.object.answer_for_field(field.id)&.answer_value, required: field.required, class: "w-full px-4 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"
                  
                  - when "single_choice"
                    - field.options.each do |option|
                      .flex.items-center.gap-2.mb-2
                        = radio_button_tag "answers[#{field.id}]", option, @presenter.decorated_attempt.object.answer_for_field(field.id)&.answer_value == option, required: field.required, class: "w-4 h-4 text-emerald-500 bg-slate-700 border-slate-600 focus:ring-emerald-500"
                        = label_tag "answers_#{field.id}_#{option.parameterize}", option, class: "text-sm text-slate-300"
                  
                  - when "multiple_choice"
                    - field.options.each do |option|
                      .flex.items-center.gap-2.mb-2
                        = check_box_tag "answers[#{field.id}][]", option, (@presenter.decorated_attempt.object.answer_for_field(field.id)&.answer_value_array || []).include?(option), class: "w-4 h-4 rounded text-emerald-500 bg-slate-700 border-slate-600 focus:ring-emerald-500"
                        = label_tag "answers_#{field.id}_#{option.parameterize}", option, class: "text-sm text-slate-300"
                  
                  - when "hidden_letter"
                    - if field.image_url.present?
                      img.mb-3.rounded-lg.max-w-md src=field.image_url alt=field.display_text class="border border-slate-600"
                    - if field.display_text.present?
                      p.text-sm.text-slate-300.mb-2 = field.display_text
                    - if field.hint.present?
                      p.text-xs.text-slate-400.italic.mb-2 = "Hint: #{field.hint}"
                    = text_field_tag "answers[#{field.id}]", @presenter.decorated_attempt.object.answer_for_field(field.id)&.answer_value, required: field.required, maxlength: field.number_of_blanks, class: "w-full px-4 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors", placeholder: t('.hidden_letter_placeholder', count: field.number_of_blanks)
                  
                  - when "photo_upload"
                    - (1..field.max_photos).each do |i|
                      .mb-3
                        = file_field_tag "photos[#{field.id}][]", accept: "image/*", required: (field.required && i == 1), class: "block w-full text-sm text-slate-300 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-emerald-500 file:text-white hover:file:bg-emerald-400"
                        - if field.require_caption
                          = text_field_tag "photo_captions[#{field.id}][#{i}]", nil, placeholder: t('.photo_caption_placeholder'), class: "mt-2 w-full px-4 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"
                      - if field.max_photos > 1
                        p.text-xs.text-slate-400.mt-1 = t('.photo_count_hint', required: field.required ? 1 : 0, max: field.max_photos)
              
              - if challenge.fields.empty?
                div
                  = label_tag :evidence_url, t('.evidence_url'), class: "block text-sm font-medium text-slate-300 mb-2"
                  = text_field_tag :evidence_url, @presenter.decorated_attempt.evidence_url, placeholder: t('.evidence_placeholder'), class: "w-full px-4 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"
              
              = submit_tag t('.submit_button'), class: "w-full px-6 py-3 rounded-lg font-medium text-white bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 shadow-lg shadow-emerald-500/25 transition-all cursor-pointer"

        - if @presenter.can_review?
          .border-t.pt-6 class="border-slate-700"
            h2.text-lg.font-semibold.text-white.mb-4 = t('.review_attempt')
            
            / Display submitted answers for review
            - if @presenter.decorated_attempt.object.challenge.has_fields?
              .mb-6
                h3.text-md.font-medium.text-slate-300.mb-3 = t('.submitted_answers')
                .space-y-3
                  - @presenter.decorated_attempt.object.response_results.each do |result|
                    .rounded-lg.p-3 class="#{result[:is_correct] ? 'bg-emerald-500/10 border border-emerald-500/30' : 'bg-slate-700/50'}"
                      .flex.items-start.justify-between
                        div
                          .text-sm.font-medium.text-slate-300 = result[:label]
                          .text-white.mt-1 = result[:response].presence || t('.no_answer')
                        .text-right
                          - if result[:is_correct]
                            span.text-emerald-400.text-sm = "✓ #{result[:points_earned]}/#{result[:max_points]} pts"
                          - else
                            span.text-red-400.text-sm = "✗ 0/#{result[:max_points]} pts"

            / Display uploaded photos for review
            - photos = @presenter.decorated_attempt.object.photos
            - if photos.any?
              .mb-6
                h3.text-md.font-medium.text-slate-300.mb-3 = t('.uploaded_photos')
                .grid.grid-cols-2.md:grid-cols-3.gap-3
                  - photos.each do |artifact|
                    - if artifact.file.attached?
                      .rounded-lg.overflow-hidden.border class="border-slate-600"
                        = image_tag artifact.file, class: "w-full h-32 object-cover"

            .flex.gap-4
              = link_to approve_attempt_path(@presenter.decorated_attempt), method: :post, data: { turbo_method: :post, turbo_confirm: t('.confirm_approve') }, class: "flex-1 text-center px-6 py-3 rounded-lg font-medium text-white bg-emerald-600 hover:bg-emerald-500 transition-all" do
                = t('.approve')
              = link_to reject_attempt_path(@presenter.decorated_attempt), method: :post, data: { turbo_method: :post, turbo_confirm: t('.confirm_reject') }, class: "flex-1 text-center px-6 py-3 rounded-lg font-medium text-white bg-red-600 hover:bg-red-500 transition-all" do
                = t('.reject')


