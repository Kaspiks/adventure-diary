- content_for :title, t('.title')

.min-h-screen.bg-slate-900.py-8
  .max-w-4xl.mx-auto.px-4
    = link_to challenges_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-white mb-4" do
      svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
        path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"
      = t('.back')

    .mb-8
      h1.text-3xl.font-bold.text-white = t('.title')
      p.text-slate-400.mt-2 = t('.subtitle', count: @presenter.total_count)

    - if @presenter.decorated_attempts.any?
      .space-y-4
        - @presenter.decorated_attempts.each do |attempt|
          .rounded-xl.border.p-6.transition-all class="bg-slate-800/50 border-slate-700 hover:border-slate-600"
            .flex.items-start.justify-between
              div
                h3.text-lg.font-semibold.text-white.mb-2 = attempt.challenge_title
                .flex.items-center.gap-3
                  span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-#{attempt.status_color}-500/20 text-#{attempt.status_color}-300"
                    = attempt.status_name
                  .text-sm.text-slate-400 = t('.started', date: attempt.started_at_formatted)
              .text-right
                - if attempt.score_awarded
                  .text-xl.font-bold.text-emerald-400 +#{attempt.score_awarded} pts
                = link_to attempt_path(attempt), class: "inline-flex items-center gap-2 mt-2 text-sm text-emerald-400 hover:text-emerald-300" do
                  = t('.view_details')
                  svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                    path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"
    - else
      .text-center.py-12
        .text-slate-400.mb-4 = t('.no_attempts')
        = link_to t('.browse_challenges'), challenges_path, class: "text-emerald-400 hover:text-emerald-300"







