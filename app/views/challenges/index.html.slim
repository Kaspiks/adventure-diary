- content_for :title, t('.title')

.min-h-screen.bg-slate-900.py-6.sm:py-8
  .max-w-6xl.mx-auto.px-4
    = link_to root_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-white mb-4" do
      = icon "arrow-left", class: "w-4 h-4"
      = t('.back')
    .mb-6.sm:mb-8
      h1.text-2xl.sm:text-3xl.font-bold.text-white = t('.title')
      p.text-sm.sm:text-base.text-slate-400.mt-1.sm:mt-2 = t('.subtitle', count: @presenter.total_count)

    .grid.grid-cols-1.sm:grid-cols-2.lg:grid-cols-3.gap-4.sm:gap-6
      - @presenter.decorated_challenges.each do |challenge|
        .rounded-xl.border.overflow-hidden.transition-all.duration-200 class="bg-slate-800/50 border-slate-700 hover:border-slate-600 hover:shadow-lg"
          .p-4.sm:p-6
            .flex.items-start.justify-between.mb-3.sm:mb-4
              span class="inline-flex items-center px-2 sm:px-2.5 py-0.5 rounded-full text-xs font-medium bg-#{challenge.status_color}-500/20 text-#{challenge.status_color}-300"
                = challenge.type_name
              .text-emerald-400.font-bold.text-sm.sm:text-base = challenge.points_display

            h3.text-base.sm:text-lg.font-semibold.text-white.mb-2 = challenge.title

            - if challenge.description.present?
              p.text-slate-400.text-xs.sm:text-sm.mb-3.sm:mb-4.line-clamp-2 = truncate(challenge.description, length: 100)

            .flex.flex-wrap.items-center.gap-3.sm:gap-4.text-xs.sm:text-sm.text-slate-400.mb-3.sm:mb-4
              .flex.items-center.gap-1
                = icon "map-pin", class: "w-4 h-4"
                span.truncate.max-w-28.sm:max-w-none = challenge.location_name
              .flex.items-center.gap-1
                = icon "star", class: "w-4 h-4"
                = challenge.difficulty_name

            = link_to challenge_path(challenge), class: "block w-full text-center px-4 py-2 rounded-lg font-medium text-white text-sm bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 transition-all" do
              = t('.view_details')

    - if @presenter.decorated_challenges.empty?
      .text-center.py-12
        = icon "map-pin", class: "w-12 h-12 text-slate-600 mx-auto mb-4"
        .text-slate-400 = t('.no_challenges')