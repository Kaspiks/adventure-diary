- content_for :title, t('.title')

.min-h-screen.bg-slate-900.py-8
  .max-w-6xl.mx-auto.px-4
    = link_to root_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-white mb-4" do
      svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
        path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"
      = t('.back')
    .mb-8
      h1.text-3xl.font-bold.text-white = t('.title')
      p.text-slate-400.mt-2 = t('.subtitle', count: @presenter.total_count)

    .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-3.gap-6
      - @presenter.decorated_challenges.each do |challenge|
        .rounded-xl.border.overflow-hidden.transition-all.duration-200 class="bg-slate-800/50 border-slate-700 hover:border-slate-600 hover:shadow-lg"
          .p-6
            .flex.items-start.justify-between.mb-4
              span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-#{challenge.status_color}-500/20 text-#{challenge.status_color}-300"
                = challenge.type_name
              .text-emerald-400.font-bold = challenge.points_display

            h3.text-lg.font-semibold.text-white.mb-2 = challenge.title

            - if challenge.description.present?
              p.text-slate-400.text-sm.mb-4.line-clamp-2 = truncate(challenge.description, length: 100)

            .flex.items-center.gap-4.text-sm.text-slate-400.mb-4
              .flex.items-center.gap-1
                svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                  path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.273 1.765 11.842 11.842 0 00.976.544l.062.029.018.008.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd"
                = challenge.location_name
              .flex.items-center.gap-1
                svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                  path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z" clip-rule="evenodd"
                = challenge.difficulty_name

            = link_to challenge_path(challenge), class: "block w-full text-center px-4 py-2 rounded-lg font-medium text-white bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 transition-all" do
              = t('.view_details')

    - if @presenter.decorated_challenges.empty?
      .text-center.py-12
        .text-slate-400 = t('.no_challenges')







