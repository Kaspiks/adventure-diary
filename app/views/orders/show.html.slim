- content_for :title, t('.title')

.min-h-screen.bg-slate-900.py-8
  .max-w-4xl.mx-auto.px-4
    = link_to orders_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-white mb-4" do
      svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
        path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"
      = t('.back')

    .rounded-xl.border.overflow-hidden class="bg-slate-800/50 border-slate-700"
      .p-8
        .flex.items-start.justify-between.mb-6
          div
            .flex.items-center.gap-3.mb-2
              span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-#{@presenter.decorated_order.status_color}-500/20 text-#{@presenter.decorated_order.status_color}-300"
                = @presenter.decorated_order.status_name
            h1.text-3xl.font-bold.text-white = @presenter.decorated_order.reward_title
          .text-right
            .text-3xl.font-bold.text-emerald-400 = @presenter.decorated_order.points_display
            .text-sm.text-slate-400 = t('.points_spent')

        .grid.grid-cols-2.gap-4.mb-6
          .flex.items-center.gap-2.text-slate-300
            svg.w-5.h-5.text-slate-400 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
              path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd"
            = t('.ordered_at', date: @presenter.decorated_order.ordered_at)
          .flex.items-center.gap-2.text-slate-300
            svg.w-5.h-5.text-slate-400 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
              path d="M10 8a3 3 0 100-6 3 3 0 000 6zM3.465 14.493a1.23 1.23 0 00.41 1.412A9.957 9.957 0 0010 18c2.31 0 4.438-.784 6.131-2.1.43-.333.604-.903.408-1.41a7.002 7.002 0 00-13.074.003z"
            = t('.offered_by', name: @presenter.decorated_order.reward_owner_name)

        .border-t.pt-6 class="border-slate-700"
          h2.text-lg.font-semibold.text-white.mb-4 = t('.status_timeline')
          .space-y-4
            .flex.items-center.gap-3
              .w-8.h-8.rounded-full.flex.items-center.justify-center class="bg-emerald-500/20"
                svg.w-4.h-4.text-emerald-400 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                  path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"
              .text-slate-300 = t('.order_placed')
              .text-sm.text-slate-500 = @presenter.decorated_order.ordered_at

            - if @presenter.order.approved? || @presenter.order.delivered?
              .flex.items-center.gap-3
                .w-8.h-8.rounded-full.flex.items-center.justify-center class="bg-blue-500/20"
                  svg.w-4.h-4.text-blue-400 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                    path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"
                .text-slate-300 = t('.order_approved')

            - if @presenter.order.delivered?
              .flex.items-center.gap-3
                .w-8.h-8.rounded-full.flex.items-center.justify-center class="bg-emerald-500/20"
                  svg.w-4.h-4.text-emerald-400 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                    path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"
                .text-slate-300 = t('.order_delivered')

            - if @presenter.order.cancelled?
              .flex.items-center.gap-3
                .w-8.h-8.rounded-full.flex.items-center.justify-center class="bg-red-500/20"
                  svg.w-4.h-4.text-red-400 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                    path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"
                .text-slate-300 = t('.order_cancelled')

