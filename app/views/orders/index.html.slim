- content_for :title, t('.title')

.min-h-screen.bg-slate-900.py-6.sm:py-8
  .max-w-6xl.mx-auto.px-4
    = link_to root_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-white mb-4" do
      = icon "arrow-left", class: "w-4 h-4"
      = t('.back')

    .mb-6.sm:mb-8
      h1.text-2xl.sm:text-3xl.font-bold.text-white = t('.title')
      p.text-sm.sm:text-base.text-slate-400.mt-1.sm:mt-2 = t('.subtitle', count: @presenter.total_count)

    - if @presenter.decorated_orders.any?
      .space-y-3.sm:space-y-4
        - @presenter.decorated_orders.each do |order|
          .rounded-xl.border.overflow-hidden.transition-all.duration-200 class="bg-slate-800/50 border-slate-700 hover:border-slate-600"
            .p-4.sm:p-6
              .flex.flex-col.sm:flex-row.sm:items-center.sm:justify-between.gap-4
                .flex.items-center.gap-3.sm:gap-4
                  .w-10.h-10.sm:w-12.sm:h-12.rounded-lg.flex.items-center.justify-center.flex-shrink-0 class="bg-#{order.status_color}-500/20"
                    = icon "shopping-cart", class: "w-5 h-5 sm:w-6 sm:h-6 text-#{order.status_color}-400"
                  div.min-w-0
                    h3.text-base.sm:text-lg.font-semibold.text-white.truncate = order.reward_title
                    .flex.flex-wrap.items-center.gap-2.text-xs.sm:text-sm.text-slate-400
                      span = order.ordered_at
                      span.text-slate-600.hidden.sm:inline •
                      span class="text-#{order.status_color}-400" = order.status_name
                .flex.items-center.justify-between.sm:flex-col.sm:items-end.gap-2.sm:gap-1
                  .text-base.sm:text-lg.font-bold.text-emerald-400 = order.points_display
                  = link_to t('.view_details'), order_path(order), class: "text-xs sm:text-sm text-slate-400 hover:text-white"

    - else
      .text-center.py-12
        = icon "shopping-cart", class: "w-12 h-12 text-slate-600 mx-auto mb-4"
        .text-slate-400.mb-4 = t('.no_orders')
        = link_to t('.browse_rewards'), rewards_path, class: "text-emerald-400 hover:text-emerald-300"