.min-h-screen class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900"
  nav.border-b.sticky.top-0.z-50 class="border-white/10 bg-slate-900/50 backdrop-blur-xl"
    .max-w-4xl.mx-auto.px-4.sm:px-6.lg:px-8
      .flex.items-center.justify-between.h-16
        .flex.items-center.gap-3
          = link_to root_path, class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-700 transition-colors" do
            svg.w-5.h-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
              path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"
          h1.text-xl.font-bold.text-white = t('.title')

        = link_to edit_user_registration_path, class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-white transition-colors bg-slate-700 hover:bg-slate-600" do
          svg.w-5.h-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
            path d="M5.433 13.917l1.262-3.155A4 4 0 017.58 9.42l6.92-6.918a2.121 2.121 0 013 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 01-.65-.65z"
            path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0010 3H4.75A2.75 2.75 0 002 5.75v9.5A2.75 2.75 0 004.75 18h9.5A2.75 2.75 0 0017 15.25V10a.75.75 0 00-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5z"
          span = t('.edit')

  .max-w-4xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8
    .grid.gap-6 class="lg:grid-cols-3"
      aside.space-y-6
        .rounded-2xl.border.p-6 class="bg-slate-800/50 border-white/10"
          .flex.flex-col.items-center.text-center
            .w-24.h-24.rounded-full.flex.items-center.justify-center.text-3xl.font-bold.text-white.mb-4 class="bg-gradient-to-br from-violet-500 to-purple-600"
              = @presenter.decorated_current_user.initials
            h2.text-xl.font-semibold.text-white = @presenter.decorated_current_user.full_name
            p.text-slate-400 = @presenter.decorated_current_user.email

      .lg:col-span-2.space-y-6
        .rounded-2xl.border.p-6 class="bg-slate-800/50 border-white/10"
          h3.text-lg.font-semibold.text-white.mb-4 = t('.personal_info')
          
          dl.space-y-4
            .flex.items-center.justify-between.py-3.border-b class="border-white/10"
              dt.text-slate-400 = t('.fields.first_name')
              dd.font-medium.text-white = @presenter.decorated_current_user.first_name

            .flex.items-center.justify-between.py-3.border-b class="border-white/10"
              dt.text-slate-400 = t('.fields.last_name')
              dd.font-medium.text-white = @presenter.decorated_current_user.last_name

            .flex.items-center.justify-between.py-3.border-b class="border-white/10"
              dt.text-slate-400 = t('.fields.email')
              dd.font-medium.text-white = @presenter.decorated_current_user.email

            .flex.items-center.justify-between.py-3
              dt.text-slate-400 = t('.fields.member_since')
              dd.font-medium.text-white = l(@presenter.decorated_current_user.created_at, format: :long)

    .rounded-xl.p-5.border.mt-10 class="bg-gradient-to-br from-cyan-500/10 to-blue-500/10 border-cyan-500/20"
      .flex.items-center.justify-between
        div
        .w-12.h-12.rounded-full.flex.items-center.justify-center class="bg-cyan-500/20"
          svg.w-6.h-6.text-cyan-400 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
            path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"

      .grid.lg:grid-cols-3.gap-6
        .rounded-2xl.border.p-6 class="bg-slate-800/50 border-white/10"
          .flex.items-center.justify-between.mb-4
            = link_to challenges_path, class: "text-sm text-amber-400 hover:text-amber-300" do
              = "Test"