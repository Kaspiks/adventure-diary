- content_for :title, @presenter.decorated_reward.title

.min-h-screen.bg-slate-900.py-8
  .max-w-4xl.mx-auto.px-4
    = link_to rewards_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-white mb-4" do
      svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
        path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"
      = t('.back')

    .rounded-xl.border.overflow-hidden class="bg-slate-800/50 border-slate-700"
      - if @presenter.decorated_reward.has_image?
        .h-64.overflow-hidden
          = image_tag @presenter.decorated_reward.image, class: "w-full h-full object-cover"

      .p-8
        .flex.items-start.justify-between.mb-6
          div
            .flex.items-center.gap-3.mb-2
              span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-#{@presenter.decorated_reward.status_color}-500/20 text-#{@presenter.decorated_reward.status_color}-300"
                = @presenter.decorated_reward.status_badge
              span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-#{@presenter.decorated_reward.stock_color}-500/20 text-#{@presenter.decorated_reward.stock_color}-300"
                = @presenter.decorated_reward.stock_display
            h1.text-3xl.font-bold.text-white = @presenter.decorated_reward.title
          .text-right
            .text-3xl.font-bold.text-emerald-400 = @presenter.decorated_reward.cost_display
            .text-sm.text-slate-400 = t('.cost')

        .grid.grid-cols-2.gap-4.mb-6
          .flex.items-center.gap-2.text-slate-300
            svg.w-5.h-5.text-slate-400 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
              path d="M10 8a3 3 0 100-6 3 3 0 000 6zM3.465 14.493a1.23 1.23 0 00.41 1.412A9.957 9.957 0 0010 18c2.31 0 4.438-.784 6.131-2.1.43-.333.604-.903.408-1.41a7.002 7.002 0 00-13.074.003z"
            = t('.offered_by', name: @presenter.decorated_reward.owner_name)
          .flex.items-center.gap-2.text-slate-300
            svg.w-5.h-5.text-slate-400 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
              path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd"
            = t('.your_balance', points: @presenter.user_points)

        - if @presenter.decorated_reward.description.present?
          .mb-8
            h2.text-lg.font-semibold.text-white.mb-3 = t('.description')
            .prose.prose-invert.prose-slate.max-w-none.text-slate-300
              == @presenter.decorated_reward.description_html

        .border-t.pt-6 class="border-slate-700"
          - if @presenter.can_purchase?
            = form_with url: rewards_purchase_actions_path(reward_id: @presenter.decorated_reward.id), method: :post, local: true do |f|
              = f.submit t('.purchase_reward'), class: "block w-full text-center px-6 py-3 rounded-lg font-medium text-white bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 shadow-lg shadow-emerald-500/25 transition-all cursor-pointer"
          - elsif @presenter.reward.out_of_stock?
            .text-center
              .text-red-400.font-medium = t('.out_of_stock')
          - elsif !@presenter.reward.is_active?
            .text-center
              .text-slate-400.font-medium = t('.not_available')
          - elsif !@presenter.can_afford?
            .text-center
              .text-amber-400.mb-2 = t('.insufficient_points')
              .text-sm.text-slate-400 = t('.points_needed', points: @presenter.points_needed)

