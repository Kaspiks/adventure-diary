- content_for :title, t('.title')

.min-h-screen.bg-slate-900.py-6.sm:py-8
  .max-w-6xl.mx-auto.px-4
    = link_to root_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-white mb-4" do
      = icon "arrow-left", class: "w-4 h-4"
      = t('.back')

    .mb-6.sm:mb-8
      .flex.flex-col.sm:flex-row.sm:items-center.sm:justify-between.gap-4
        div
          h1.text-2xl.sm:text-3xl.font-bold.text-white = t('.title')
          p.text-sm.sm:text-base.text-slate-400.mt-1.sm:mt-2 = t('.subtitle', count: @presenter.total_count)
        .flex.items-center.gap-2.sm:flex-col.sm:items-end.sm:gap-0
          .text-sm.text-slate-400 = t('.your_points')
          .text-xl.sm:text-2xl.font-bold.text-emerald-400 = "#{@presenter.user_points} pts"

    .grid.grid-cols-1.sm:grid-cols-2.lg:grid-cols-3.gap-4.sm:gap-6
      - @presenter.decorated_rewards.each do |reward|
        .rounded-xl.border.overflow-hidden.transition-all.duration-200 class="bg-slate-800/50 border-slate-700 hover:border-slate-600 hover:shadow-lg"
          - if reward.has_image?
            .h-32.sm:h-40.overflow-hidden
              = image_tag reward.image, class: "w-full h-full object-cover"
          - else
            .h-32.sm:h-40.flex.items-center.justify-center class="bg-slate-700/50"
              = icon("gift", width: 40, height: 40, class: "text-slate-500 sm:w-12 sm:h-12")
          .p-4.sm:p-6
            .flex.items-start.justify-between.mb-3.sm:mb-4
              span class="inline-flex items-center px-2 sm:px-2.5 py-0.5 rounded-full text-xs font-medium bg-#{reward.status_color}-500/20 text-#{reward.status_color}-300"
                = reward.status_badge
              .text-emerald-400.font-bold.text-sm.sm:text-base = reward.cost_display

            h3.text-base.sm:text-lg.font-semibold.text-white.mb-2 = reward.title

            - if reward.description.present?
              p.text-slate-400.text-xs.sm:text-sm.mb-3.sm:mb-4.line-clamp-2 = reward.truncated_description

            .flex.flex-wrap.items-center.gap-3.sm:gap-4.text-xs.sm:text-sm.text-slate-400.mb-3.sm:mb-4
              .flex.items-center.gap-1
                = icon "user", class: "w-4 h-4"
                span.truncate.max-w-24.sm:max-w-none = reward.owner_name
              .flex.items-center.gap-1 class="text-#{reward.stock_color}-400"
                = icon "package", class: "w-4 h-4"
                = reward.stock_display

            - if @presenter.can_afford?(reward.object)
              = link_to reward_path(reward), class: "block w-full text-center px-4 py-2 rounded-lg font-medium text-white text-sm bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 transition-all" do
                = t('.view_details')
            - else
              = link_to reward_path(reward), class: "block w-full text-center px-4 py-2 rounded-lg font-medium text-slate-400 text-sm bg-slate-700 hover:bg-slate-600 transition-all" do
                = t('.view_details')

    - if @presenter.decorated_rewards.empty?
      .text-center.py-12
        .text-slate-400 = t('.no_rewards')