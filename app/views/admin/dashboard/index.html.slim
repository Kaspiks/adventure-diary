.mb-8
  h1.text-3xl.font-bold.text-white = @presenter.title
  p.text-slate-400.mt-1 = @presenter.subtitle

.grid.grid-cols-2.lg:grid-cols-4.gap-4.mb-8
  .rounded-xl.p-5.border class="bg-slate-800 border-slate-700"
    .flex.items-center.justify-between
      div
        p.text-sm.text-slate-400 = @presenter.stats_labels[:total_users]
        p.text-2xl.font-bold.text-white = @presenter.stats[:total_users]
      .w-12.h-12.rounded-full.flex.items-center.justify-center class="bg-blue-500/20"
        = icon(:users, class: "text-blue-400")

  .rounded-xl.p-5.border class="bg-slate-800 border-slate-700"
    .flex.items-center.justify-between
      div
        p.text-sm.text-slate-400 = @presenter.stats_labels[:active_users]
        p.text-2xl.font-bold.text-white = @presenter.stats[:active_users]
      .w-12.h-12.rounded-full.flex.items-center.justify-center class="bg-emerald-500/20"
        = icon(:check, class: "text-emerald-400")

  .rounded-xl.p-5.border class="bg-slate-800 border-slate-700"
    .flex.items-center.justify-between
      div
        p.text-sm.text-slate-400 = @presenter.stats_labels[:blocked_users]
        p.text-2xl.font-bold.text-white = @presenter.stats[:blocked_users]
      .w-12.h-12.rounded-full.flex.items-center.justify-center class="bg-red-500/20"
        = icon(:x, class: "text-red-400")

  .rounded-xl.p-5.border class="bg-slate-800 border-slate-700"
    .flex.items-center.justify-between
      div
        p.text-sm.text-slate-400 = @presenter.stats_labels[:admins]
        p.text-2xl.font-bold.text-white = @presenter.stats[:admins]
      .w-12.h-12.rounded-full.flex.items-center.justify-center class="bg-purple-500/20"
        = icon(:target, class: "text-purple-400")

.grid.lg:grid-cols-3.gap-6
  .lg:col-span-2.rounded-xl.border.p-6 class="bg-slate-800 border-slate-700"
    .flex.items-center.justify-between.mb-4
      h2.text-lg.font-semibold.text-white = @presenter.recent_users_labels[:title]
      = link_to @presenter.view_all_text, admin_users_path, class: "text-sm text-amber-400 hover:text-amber-300"
    
    - if @presenter.recent_users.any?
      .overflow-x-auto
        table.w-full
          thead
            tr.text-left.text-sm.text-slate-400
              th.pb-3.font-medium = @presenter.recent_users_labels[:name]
              th.pb-3.font-medium = @presenter.recent_users_labels[:email]
              th.pb-3.font-medium = @presenter.recent_users_labels[:status]
              th.pb-3.font-medium = @presenter.recent_users_labels[:joined]
          tbody.divide-y class="divide-slate-700"
            - @presenter.recent_users.each do |user|
              tr.text-sm
                td.py-3
                  .flex.items-center.gap-3
                    .w-8.h-8.rounded-full.flex.items-center.justify-center.text-xs.font-medium.text-white class="bg-gradient-to-br from-slate-600 to-slate-700"
                      = user.initials
                    span.text-white = user.full_name
                td.py-3.text-slate-400 = user.email
                td.py-3
                  - if user.blocked?
                    span.px-2.py-1.rounded-full.text-xs.font-medium class="bg-red-500/20 text-red-400" = @presenter.recent_users_labels[:blocked]
                  - elsif user.admin?
                    span.px-2.py-1.rounded-full.text-xs.font-medium class="bg-purple-500/20 text-purple-400" = @presenter.recent_users_labels[:admin]
                  - else
                    span.px-2.py-1.rounded-full.text-xs.font-medium class="bg-emerald-500/20 text-emerald-400" = @presenter.recent_users_labels[:active]
                td.py-3.text-slate-400 = l(user.created_at, format: :short)
    - else
      .text-center.py-8
        p.text-slate-400 = @presenter.recent_users_labels[:empty]

  .rounded-xl.border.p-6 class="bg-slate-800 border-slate-700"
    h2.text-lg.font-semibold.text-white.mb-4 = @presenter.quick_actions_labels[:title]
    .space-y-3
      = link_to admin_users_path, class: "flex items-center gap-3 p-3 rounded-lg transition-colors hover:bg-slate-700/50 group" do
        .w-10.h-10.rounded-lg.flex.items-center.justify-center class="bg-blue-500/20"
          = icon(:lock, width: 20, height: 20, class: "text-blue-400")
        span.text-slate-300.group-hover:text-white = @presenter.quick_actions_labels[:manage_users]

      = link_to new_admin_challenge_path, class: "flex items-center gap-3 p-3 rounded-lg transition-colors hover:bg-slate-700/50 group" do
        .w-10.h-10.rounded-lg.flex.items-center.justify-center class="bg-emerald-500/20"
          = icon(:circle_plus, width: 20, height: 20, class: "text-emerald-400")
        span.text-slate-300.group-hover:text-white = @presenter.quick_actions_labels[:create_challenge]

      = link_to new_admin_reward_path, class: "flex items-center gap-3 p-3 rounded-lg transition-colors hover:bg-slate-700/50 group" do
        .w-10.h-10.rounded-lg.flex.items-center.justify-center class="bg-amber-500/20"
          = icon(:star, width: 20, height: 20, class: "text-amber-400")
        span.text-slate-300.group-hover:text-white = @presenter.quick_actions_labels[:add_reward]

      = link_to admin_settings_path, class: "flex items-center gap-3 p-3 rounded-lg transition-colors hover:bg-slate-700/50 group" do
        .w-10.h-10.rounded-lg.flex.items-center.justify-center class="bg-purple-500/20"
          = icon(:settings, width: 20, height: 20, class: "text-purple-400")
        span.text-slate-300.group-hover:text-white = @presenter.quick_actions_labels[:app_settings]
