.space-y-6
  div
    = link_to admin_roles_path, class: "inline-flex items-center gap-1 text-slate-400 hover:text-white transition-colors mb-2" do
      svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
        path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"
      = t('.back')
    .flex.flex-col.sm:flex-row.sm:items-center.sm:justify-between.gap-4
      h1.text-2xl.font-bold.text-white = @presenter.decorated_role.name

      .flex.flex-wrap.gap-2
        = link_to edit_admin_role_path(@presenter.role), class: "inline-flex items-center gap-2 px-3 py-2 sm:px-4 rounded-lg text-sm font-medium text-white transition-all duration-200 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 shadow-lg shadow-emerald-500/25" do
          svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
            path d="M5.433 13.917l1.262-3.155A4 4 0 017.58 9.42l6.92-6.918a2.121 2.121 0 013 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 01-.65-.65z"
            path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0010 3H4.75A2.75 2.75 0 002 5.75v9.5A2.75 2.75 0 004.75 18h9.5A2.75 2.75 0 0017 15.25V10a.75.75 0 00-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5z"
          = t('.edit')
        - if @presenter.can_delete?
          = link_to admin_role_path(@presenter.role), data: { turbo_method: :delete, turbo_confirm: t('.confirm_delete') }, class: "inline-flex items-center gap-2 px-3 py-2 sm:px-4 rounded-lg text-sm font-medium text-white transition-all duration-200 bg-red-500 hover:bg-red-400" do
            svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
              path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.519.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd"
            = t('.delete')

  .grid.gap-6 class="lg:grid-cols-3"
    .col-span-2.space-y-6
      .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
        h3.text-lg.font-semibold.text-white.mb-4 = t('.sections.info')
        
        dl.space-y-4
          div
            dt.text-sm.text-slate-400 = t('.name')
            dd.text-white.font-medium = @presenter.decorated_role.name
          div
            dt.text-sm.text-slate-400 = t('.description')
            dd.text-white = @presenter.decorated_role.description || "-"
          div
            dt.text-sm.text-slate-400 = t('.users_count')
            dd.text-white = @presenter.users_count

      .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
        h3.text-lg.font-semibold.text-white.mb-4 = t('.sections.permissions')

        - if @presenter.permissions_grouped.empty?
          p.text-slate-400 = t('.no_permissions')
        - else
          .space-y-6
            - @presenter.permissions_grouped.each do |resource, permissions|
              div
                h4.text-sm.font-medium.text-emerald-400.uppercase.tracking-wider.mb-2 = resource.titleize
                .flex.flex-wrap.gap-2
                  - permissions.each do |permission|
                    span.inline-flex.items-center.px-3.py-1.rounded-full.text-xs.font-medium class="bg-slate-700 text-slate-300"
                      = permission.code.split(".").last.titleize

    aside.space-y-6
      .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
        h3.text-lg.font-semibold.text-white.mb-4 = t('.sections.stats')
        
        dl.space-y-4
          .flex.justify-between
            dt.text-sm.text-slate-400 = t('.total_permissions')
            dd.text-white.font-medium = @presenter.decorated_role.permissions_count
          .flex.justify-between
            dt.text-sm.text-slate-400 = t('.total_users')
            dd.text-white.font-medium = @presenter.users_count
          .flex.justify-between
            dt.text-sm.text-slate-400 = t('.created_at')
            dd.text-white.text-sm = l(@presenter.decorated_role.created_at, format: :long)






