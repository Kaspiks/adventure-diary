.rounded-xl.border.overflow-hidden class="bg-slate-800/50 border-slate-700"
  table.w-full
    thead class="bg-slate-800/80"
      tr
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-400.uppercase.tracking-wider = t('.headers.name')
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-400.uppercase.tracking-wider = t('.headers.description')
        th.px-6.py-3.text-center.text-xs.font-medium.text-slate-400.uppercase.tracking-wider = t('.headers.permissions')
        th.px-6.py-3.text-center.text-xs.font-medium.text-slate-400.uppercase.tracking-wider = t('.headers.users')
        th.px-6.py-3.text-right.text-xs.font-medium.text-slate-400.uppercase.tracking-wider = t('.headers.actions')

    tbody.divide-y class="divide-slate-700"
      - if roles.empty?
        tr
          td.px-6.py-8.text-center.text-slate-400 colspan="5"
            = t('.no_roles')
      - else
        - roles.each do |role|
          tr class="hover:bg-slate-700/50 transition-colors"
            td.px-6.py-4
              .font-medium.text-white = role.name
            td.px-6.py-4.text-slate-300.text-sm = role.description || "-"
            td.px-6.py-4.text-center
              span.inline-flex.items-center.px-2.5.py-0.5.rounded-full.text-xs.font-medium class="bg-emerald-500/20 text-emerald-400"
                = role.permissions_count
            td.px-6.py-4.text-center
              span.inline-flex.items-center.px-2.5.py-0.5.rounded-full.text-xs.font-medium class="bg-blue-500/20 text-blue-400"
                = role.users_count
            td.px-6.py-4.text-right
              .flex.items-center.justify-end.gap-2
                = link_to admin_role_path(role), class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-700 transition-colors" do
                  svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                    path d="M10 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z"
                    path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 010-1.186A10.004 10.004 0 0110 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0110 17c-4.257 0-7.893-2.66-9.336-6.41zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"
                = link_to edit_admin_role_path(role), class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-700 transition-colors" do
                  svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                    path d="M5.433 13.917l1.262-3.155A4 4 0 017.58 9.42l6.92-6.918a2.121 2.121 0 013 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 01-.65-.65z"
                    path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0010 3H4.75A2.75 2.75 0 002 5.75v9.5A2.75 2.75 0 004.75 18h9.5A2.75 2.75 0 0017 15.25V10a.75.75 0 00-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5z"












