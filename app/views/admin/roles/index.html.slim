.space-y-6
  .flex.items-center.justify-between
    div
      h1.text-2xl.font-bold.text-white = t('.title')
      p.text-slate-400.mt-1 = t('.subtitle', count: @presenter.total_count)

    = link_to new_admin_role_path, class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-white transition-all duration-200 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 shadow-lg shadow-emerald-500/25" do
      svg.w-5.h-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
        path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-11.25a.75.75 0 00-1.5 0v2.5h-2.5a.75.75 0 000 1.5h2.5v2.5a.75.75 0 001.5 0v-2.5h2.5a.75.75 0 000-1.5h-2.5v-2.5z" clip-rule="evenodd"
      = t('.new_role')

  = render 'list', roles: @presenter.decorated_roles
