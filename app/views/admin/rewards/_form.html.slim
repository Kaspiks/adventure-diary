= form_with model: presenter.form, url: (presenter.form.persisted? ? admin_reward_path(presenter.form.object) : admin_rewards_path), method: (presenter.form.persisted? ? :patch : :post), data: { turbo: false }, multipart: true, class: "space-y-6" do |f|

  - if presenter.form.errors.any?
    .rounded-xl.border.p-4 class="bg-red-500/10 border-red-500/30"
      .text-red-300.font-medium.mb-2 = t('admin.rewards.form.errors')
      ul.list-disc.list-inside.text-sm.text-red-200
        - presenter.form.errors.full_messages.each do |message|
          li = message

  / Basic Information
  .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
    h2.text-lg.font-semibold.text-white.mb-4 = t('admin.rewards.form.sections.basic_info')
    .space-y-4
      div
        = f.label :title, t('admin.rewards.form.title'), class: "block text-sm font-medium text-slate-300 mb-1"
        = f.text_field :title, class: "w-full px-4 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500"
      div data-controller="tinymce" data-tinymce-height-value="300"
        = f.label :description, t('admin.rewards.form.description'), class: "block text-sm font-medium text-slate-300 mb-1"
        = f.text_area :description, rows: 8, class: "w-full px-4 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500", data: { tinymce_target: "editor" }
        .text-xs.text-slate-400.mt-1 = t('admin.rewards.form.description_hint')

  / Image
  .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
    h2.text-lg.font-semibold.text-white.mb-4 = t('admin.rewards.form.sections.image')
    .space-y-4
      - if presenter.form.has_image?
        .mb-4
          .text-sm.text-slate-400.mb-2 = t('admin.rewards.form.current_image')
          .w-48.h-48.rounded-lg.overflow-hidden.border class="border-slate-600"
            = image_tag presenter.form.object.image, class: "w-full h-full object-cover"
      div data-controller="file-preview"
        = f.label :image, t('admin.rewards.form.image'), class: "block text-sm font-medium text-slate-300 mb-1"
        .flex.items-center.gap-4
          label.cursor-pointer.px-4.py-2.rounded-lg.font-medium.text-slate-300.bg-slate-700.border.border-slate-600.hover:bg-slate-600.transition-all.inline-flex.items-center.gap-2
            = icon("photo", width: 20, height: 20)
            span data-file-preview-target="label" = t('admin.rewards.form.choose_image')
            = f.file_field :image, accept: "image/jpeg,image/png,image/gif,image/webp", class: "hidden", data: { file_preview_target: "input", action: "change->file-preview#updateLabel" }
        .text-xs.text-slate-400.mt-2 = t('admin.rewards.form.image_hint')

  / Pricing & Stock
  .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
    h2.text-lg.font-semibold.text-white.mb-4 = t('admin.rewards.form.sections.pricing')
    .grid.grid-cols-1.md:grid-cols-2.gap-4
      div
        = f.label :cost_points, t('admin.rewards.form.cost_points'), class: "block text-sm font-medium text-slate-300 mb-1"
        = f.number_field :cost_points, min: 1, class: "w-full px-4 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        .text-xs.text-slate-400.mt-1 = t('admin.rewards.form.cost_points_hint')
      div
        = f.label :stock_quantity, t('admin.rewards.form.stock_quantity'), class: "block text-sm font-medium text-slate-300 mb-1"
        = f.number_field :stock_quantity, min: 0, class: "w-full px-4 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        .text-xs.text-slate-400.mt-1 = t('admin.rewards.form.stock_quantity_hint')

  / Status
  .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
    h2.text-lg.font-semibold.text-white.mb-4 = t('admin.rewards.form.sections.status')
    .flex.items-center.gap-3
      = f.check_box :is_active, class: "w-5 h-5 rounded bg-slate-700 border-slate-600 text-emerald-500 focus:ring-emerald-500 focus:ring-offset-slate-800"
      = f.label :is_active, t('admin.rewards.form.is_active'), class: "text-sm font-medium text-slate-300"

  / Actions
  .flex.items-center.gap-4
    = f.submit (presenter.form.persisted? ? t('admin.rewards.form.submit_update') : t('admin.rewards.form.submit_create')), class: "px-6 py-2 rounded-lg font-medium text-white bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 transition-all cursor-pointer"
    = link_to t('admin.rewards.form.cancel'), admin_rewards_path, class: "px-6 py-2 rounded-lg font-medium text-slate-300 bg-slate-700 hover:bg-slate-600 transition-all"
