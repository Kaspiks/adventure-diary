.field-item.rounded-lg.border.p-4.mb-4 class="bg-slate-700/50 border-slate-600" data-field-index=index
  .flex.items-start.justify-between.mb-3
    h3.text-md.font-medium.text-white = field.label.presence || t('.new_field')
    = button_tag type: "button", class: "text-red-400 hover:text-red-300", data: { action: "click->challenge-fields#removeField" } do
      svg.w-5.h-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
        path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.519.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5z" clip-rule="evenodd"

  = hidden_field_tag "admin_challenges_form[fields_config][#{index}][id]", field.id
  = hidden_field_tag "admin_challenges_form[fields_config][#{index}][type]", field.type.to_s, data: { "challenge-fields-target" => "fieldType" }, id: "field_type_#{index}"

  .grid.grid-cols-2.gap-4
    .space-y-2
      = label_tag "admin_challenges_form[fields_config][#{index}][label]", t('.field_label'), class: "block text-sm font-medium text-slate-300"
      = text_field_tag "admin_challenges_form[fields_config][#{index}][label]", field.label, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"

    .space-y-2
      = label_tag "admin_challenges_form[fields_config][#{index}][points]", t('.points'), class: "block text-sm font-medium text-slate-300"
      = number_field_tag "admin_challenges_form[fields_config][#{index}][points]", field.points, min: 0, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"

  .space-y-2.mt-4
    = label_tag "admin_challenges_form[fields_config][#{index}][instructions]", t('.instructions'), class: "block text-sm font-medium text-slate-300"
    = text_area_tag "admin_challenges_form[fields_config][#{index}][instructions]", field.instructions, rows: 2, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"

  .flex.items-center.gap-4.mt-4
    = check_box_tag "admin_challenges_form[fields_config][#{index}][required]", "1", field.required, class: "w-5 h-5 rounded text-emerald-500 bg-slate-700 border-slate-600"
    = label_tag "admin_challenges_form[fields_config][#{index}][required]", t('.required'), class: "text-sm font-medium text-slate-300"

  - case field.type.to_s
  - when "text_input"
    .space-y-2.mt-4
      = label_tag "admin_challenges_form[fields_config][#{index}][correct_answer]", t('.correct_answer'), class: "block text-sm font-medium text-slate-300"
      = text_field_tag "admin_challenges_form[fields_config][#{index}][correct_answer]", field.correct_answer, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"

  - when "single_choice"
    .space-y-2.mt-4
      = label_tag "admin_challenges_form[fields_config][#{index}][options]", t('.options'), class: "block text-sm font-medium text-slate-300"
      .space-y-2 data-controller="dynamic-options"
        - (field.options.presence || [""]).each_with_index do |option, opt_idx|
          .flex.gap-2.mb-2
            = text_field_tag "admin_challenges_form[fields_config][#{index}][options][]", option, placeholder: t('.option_placeholder'), class: "flex-1 px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600"
            = radio_button_tag "admin_challenges_form[fields_config][#{index}][correct_answer]", option, field.correct_answer == option, class: "mt-2"
        = button_tag type: "button", class: "text-sm text-emerald-400 hover:text-emerald-300", data: { action: "click->dynamic-options#addOption" } do
          = t('.add_option')

  - when "multiple_choice"
    .space-y-2.mt-4
      = label_tag "admin_challenges_form[fields_config][#{index}][options]", t('.options'), class: "block text-sm font-medium text-slate-300"
      .space-y-2 data-controller="dynamic-options"
        - (field.options.presence || [""]).each_with_index do |option, opt_idx|
          .flex.gap-2.mb-2
            = text_field_tag "admin_challenges_form[fields_config][#{index}][options][]", option, placeholder: t('.option_placeholder'), class: "flex-1 px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600"
            = check_box_tag "admin_challenges_form[fields_config][#{index}][correct_answers][]", option, field.correct_answers&.include?(option), class: "mt-2"
        = button_tag type: "button", class: "text-sm text-emerald-400 hover:text-emerald-300", data: { action: "click->dynamic-options#addOption" } do
          = t('.add_option')

  - when "hidden_letter"
    .space-y-2.mt-4
      = label_tag "admin_challenges_form[fields_config][#{index}][image_url]", t('.puzzle_image_url'), class: "block text-sm font-medium text-slate-300"
      = url_field_tag "admin_challenges_form[fields_config][#{index}][image_url]", field.image_url, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"

    .space-y-2.mt-4
      = label_tag "admin_challenges_form[fields_config][#{index}][display_text]", t('.display_text'), class: "block text-sm font-medium text-slate-300"
      = text_field_tag "admin_challenges_form[fields_config][#{index}][display_text]", field.display_text, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"

    .grid.grid-cols-2.gap-4.mt-4
      .space-y-2
        = label_tag "admin_challenges_form[fields_config][#{index}][number_of_blanks]", t('.number_of_blanks'), class: "block text-sm font-medium text-slate-300"
        = number_field_tag "admin_challenges_form[fields_config][#{index}][number_of_blanks]", field.number_of_blanks, min: 1, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"

      .space-y-2
        = label_tag "admin_challenges_form[fields_config][#{index}][correct_answer]", t('.expected_answer'), class: "block text-sm font-medium text-slate-300"
        = text_field_tag "admin_challenges_form[fields_config][#{index}][correct_answer]", field.correct_answer, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"

    .space-y-2.mt-4
      = label_tag "admin_challenges_form[fields_config][#{index}][hint]", t('.hint'), class: "block text-sm font-medium text-slate-300"
      = text_field_tag "admin_challenges_form[fields_config][#{index}][hint]", field.hint, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"

    .flex.items-center.gap-4.mt-4
      = check_box_tag "admin_challenges_form[fields_config][#{index}][case_sensitive]", "1", field.case_sensitive, class: "w-5 h-5 rounded text-emerald-500 bg-slate-700 border-slate-600"
      = label_tag "admin_challenges_form[fields_config][#{index}][case_sensitive]", t('.case_sensitive'), class: "text-sm font-medium text-slate-300"

  - when "photo_upload"
    .grid.grid-cols-2.gap-4.mt-4
      .space-y-2
        = label_tag "admin_challenges_form[fields_config][#{index}][max_photos]", t('.max_photos'), class: "block text-sm font-medium text-slate-300"
        = number_field_tag "admin_challenges_form[fields_config][#{index}][max_photos]", field.max_photos, min: 1, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"

      .flex.items-center.gap-4.mt-6
        = check_box_tag "admin_challenges_form[fields_config][#{index}][require_caption]", "1", field.require_caption, class: "w-5 h-5 rounded text-emerald-500 bg-slate-700 border-slate-600"
        = label_tag "admin_challenges_form[fields_config][#{index}][require_caption]", t('.require_caption'), class: "text-sm font-medium text-slate-300"

