.space-y-2.mt-4
  = label_tag "admin_challenges_form[fields_config][#{index}][options]", t('.options'), class: "block text-sm font-medium text-slate-300"
  .space-y-2 data-controller="dynamic-options"
    - (field.options.presence || [""]).each_with_index do |option, opt_idx|
      .flex.gap-2.mb-2
        = text_field_tag "admin_challenges_form[fields_config][#{index}][options][]", option, placeholder: t('.option_placeholder'), class: "flex-1 px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600"
        = radio_button_tag "admin_challenges_form[fields_config][#{index}][correct_answer]", option, field.correct_answer == option, class: "mt-2"
    = button_tag type: "button", class: "text-sm text-emerald-400 hover:text-emerald-300", data: { action: "click->dynamic-options#addOption" } do
      = t('.add_option')


