- if challenges.any?
  / Mobile card view
  .space-y-3.sm:hidden
    - challenges.each do |challenge|
      .rounded-lg.p-4.border class="bg-slate-700/50 border-slate-600"
        .flex.items-start.justify-between.gap-3.mb-3
          div.min-w-0.flex-1
            .flex.items-center.gap-2.mb-1
              .text-sm.font-medium.text-white.truncate = challenge.title
              span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-#{challenge.status_color}-500/20 text-#{challenge.status_color}-300"
                = challenge.status_badge
            .text-xs.text-slate-400 = challenge.location_name

          .flex.items-center.gap-1.flex-shrink-0
            = link_to admin_challenge_path(challenge), class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-600 transition-colors", title: t('.actions.view') do
              svg.w-5.h-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                path d="M10 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z"
                path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 010-1.186A10.004 10.004 0 0110 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0110 17c-4.257 0-7.893-2.66-9.336-6.41zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"
            = link_to edit_admin_challenge_path(challenge), class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-600 transition-colors", title: t('.actions.edit') do
              svg.w-5.h-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                path d="M5.433 13.917l1.262-3.155A4 4 0 017.58 9.42l6.92-6.918a2.121 2.121 0 013 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 01-.65-.65z"
                path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0010 3H4.75A2.75 2.75 0 002 5.75v9.5A2.75 2.75 0 004.75 18h9.5A2.75 2.75 0 0017 15.25V10a.75.75 0 00-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5z"
            = link_to admin_challenge_path(challenge), data: { turbo_method: :delete, turbo_confirm: t('.confirm_delete') }, class: "p-2 rounded-lg text-slate-400 hover:text-red-400 hover:bg-slate-600 transition-colors", title: t('.actions.delete') do
              svg.w-5.h-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.519.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd"

        .flex.flex-wrap.items-center.gap-x-4.gap-y-2.text-xs
          .flex.items-center.gap-1.5
            span.text-slate-500 = t('.headers.type') + ":"
            span.text-slate-300 = challenge.type_name
          .flex.items-center.gap-1.5
            span.text-slate-500 = t('.headers.difficulty') + ":"
            span.text-slate-300 = challenge.difficulty_name
          .flex.items-center.gap-1.5
            span.text-slate-500 = t('.headers.points') + ":"
            span.text-slate-300 = challenge.points_display
          .flex.items-center.gap-1.5
            span.text-slate-500 = t('.headers.attempts') + ":"
            span.text-slate-300 = challenge.attempts_count
            - if challenge.pending_attempts_count > 0
              span.text-amber-400 = "(#{challenge.pending_attempts_count})"

  / Desktop table view
  .hidden.sm:block.overflow-x-auto
    table.w-full
      thead
        tr.text-left.text-xs.font-medium.text-slate-400.uppercase.tracking-wider
          th.px-6.py-3 = t('.headers.title')
          th.px-6.py-3 = t('.headers.type')
          th.px-6.py-3 = t('.headers.difficulty')
          th.px-6.py-3 = t('.headers.points')
          th.px-6.py-3 = t('.headers.status')
          th.px-6.py-3 = t('.headers.attempts')
          th.px-6.py-3.text-right = t('.headers.actions')
      tbody.divide-y class="divide-slate-700"
        - challenges.each do |challenge|
          tr.transition-colors class="hover:bg-slate-700/50"
            td.px-6.py-4
              .font-medium.text-white = challenge.title
              .text-sm.text-slate-400 = challenge.location_name
            td.px-6.py-4.text-sm.text-slate-300 = challenge.type_name
            td.px-6.py-4.text-sm.text-slate-300 = challenge.difficulty_name
            td.px-6.py-4.text-sm.text-slate-300 = challenge.points_display
            td.px-6.py-4
              span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-#{challenge.status_color}-500/20 text-#{challenge.status_color}-300"
                = challenge.status_badge
            td.px-6.py-4.text-sm.text-slate-300
              = challenge.attempts_count
              - if challenge.pending_attempts_count > 0
                span.ml-1.text-amber-400 = "(#{challenge.pending_attempts_count} pending)"
            td.px-6.py-4.text-right
              .flex.items-center.justify-end.gap-2
                = link_to admin_challenge_path(challenge), class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-700 transition-colors", title: t('.actions.view') do
                  svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                    path d="M10 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z"
                    path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 010-1.186A10.004 10.004 0 0110 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0110 17c-4.257 0-7.893-2.66-9.336-6.41zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"
                = link_to edit_admin_challenge_path(challenge), class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-700 transition-colors", title: t('.actions.edit') do
                  svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                    path d="M5.433 13.917l1.262-3.155A4 4 0 017.58 9.42l6.92-6.918a2.121 2.121 0 013 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 01-.65-.65z"
                    path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0010 3H4.75A2.75 2.75 0 002 5.75v9.5A2.75 2.75 0 004.75 18h9.5A2.75 2.75 0 0017 15.25V10a.75.75 0 00-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5z"
                = link_to admin_challenge_path(challenge), data: { turbo_method: :delete, turbo_confirm: t('.confirm_delete') }, class: "p-2 rounded-lg text-slate-400 hover:text-red-400 hover:bg-slate-700 transition-colors", title: t('.actions.delete') do
                  svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                    path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.519.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd"
- else
  .p-12.text-center
    .text-slate-400.mb-4 = t('.no_challenges')
    = link_to t('.add_first'), new_admin_challenge_path, class: "text-emerald-400 hover:text-emerald-300"
