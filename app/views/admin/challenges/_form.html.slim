= simple_form_for form, url: form.persisted? ? admin_challenge_path(form.object) : admin_challenges_path, method: form.persisted? ? :patch : :post do |f|
  .grid.grid-cols-1.lg:grid-cols-2.gap-6
    .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
      h2.text-lg.font-semibold.text-white.mb-4 = t('.sections.basic_info')

      .space-y-4
        .space-y-2
          = f.label :title, class: "block text-sm font-medium text-slate-300"
          = f.input_field :title, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"

        .space-y-2
          = f.label :description, class: "block text-sm font-medium text-slate-300"
          = f.input_field :description, as: :text, rows: 5, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"

        .space-y-2
          = f.label :location_id, class: "block text-sm font-medium text-slate-300"
          = f.input_field :location_id, collection: form.locations, label_method: :name, value_method: :id, include_blank: "Any Location", class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"

    .space-y-6
      .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
        h2.text-lg.font-semibold.text-white.mb-4 = t('.sections.settings')

        .space-y-4
          .space-y-2
            = f.label :challenge_type_id, class: "block text-sm font-medium text-slate-300"
            = f.input_field :challenge_type_id, collection: form.challenge_types, label_method: :name, value_method: :id, include_blank: false, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"

          .space-y-2
            = f.label :difficulty_level_id, class: "block text-sm font-medium text-slate-300"
            = f.input_field :difficulty_level_id, collection: form.difficulty_levels, label_method: :name, value_method: :id, include_blank: false, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"

          .space-y-2
            = f.label :award_point_level_id, class: "block text-sm font-medium text-slate-300"
            = f.input_field :award_point_level_id, collection: form.award_point_levels, label_method: ->(a) { "#{a.name} (#{a.points} pts)" }, value_method: :id, include_blank: false, class: "w-full px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"

      .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
        h2.text-lg.font-semibold.text-white.mb-4 = t('.sections.status')
        .flex.items-center.gap-3
          = f.input_field :is_active, as: :boolean, class: "w-5 h-5 rounded text-emerald-500 bg-slate-700 border-slate-600 focus:ring-emerald-500 focus:ring-offset-slate-800"
          = f.label :is_active, t('.is_active'), class: "text-sm font-medium text-slate-300"

  - if form.object.challenge_type_id.present? || form.object.persisted?
    .rounded-xl.border.p-6.mt-6 class="bg-slate-800/50 border-slate-700" data-controller="challenge-fields"
      h2.text-lg.font-semibold.text-white.mb-4 = t('.sections.fields')
      p.text-sm.text-slate-400.mb-4 = t('.fields_description')

      #fields-container data-challenge-fields-target="container"
        - form.fields.each_with_index do |field, index|
          = render 'field_form', form: form, field: field, index: index

      .mt-4
        = label_tag :field_type, t('.add_field'), class: "block text-sm font-medium text-slate-300 mb-2"
        .flex.gap-2
          = select_tag :field_type, options_for_select(form.available_field_types.map { |k, v| [v[:name], k] }), { prompt: t('.select_field_type'), class: "flex-1 px-3 py-2 rounded-lg text-white bg-slate-700 border border-slate-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500", data: { action: "change->challenge-fields#addField", challenge_fields_target: "select" } }

  .flex.justify-end.gap-3.mt-6
    = link_to t('.cancel'), form.persisted? ? admin_challenge_path(form.object) : admin_challenges_path, class: "px-4 py-2 rounded-lg font-medium text-slate-300 hover:text-white bg-slate-700 hover:bg-slate-600 transition-colors"
    = f.submit form.persisted? ? t('.submit_update') : t('.submit_create'), class: "px-4 py-2 rounded-lg font-medium text-white bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 shadow-lg shadow-emerald-500/25 transition-all cursor-pointer"


