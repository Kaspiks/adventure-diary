= simple_form_for search_form, as: :admin_order_statuses_search_form, url: admin_order_statuses_path, method: :get, html: { class: "flex flex-wrap gap-4 items-end" } do |f|
  .flex-1.min-w-48
    = f.input :name,
      label: t('.name'),
      placeholder: t('.name_placeholder'),
      label_html: { class: "block text-sm font-medium text-slate-300 mb-1" },
      input_html: { class: "w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent text-sm" }

  .flex.items-end.gap-2
    = f.submit t('.search'), class: "px-4 py-2 rounded-lg font-medium text-white cursor-pointer transition-all duration-200 bg-emerald-600 hover:bg-emerald-500"
    = link_to t('.clear'), admin_order_statuses_path, class: "px-4 py-2 rounded-lg font-medium text-slate-300 transition-colors hover:text-white hover:bg-slate-700"
