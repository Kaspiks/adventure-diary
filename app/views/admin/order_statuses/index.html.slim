- content_for :title, t('.title')

.space-y-6
  .flex.items-center.justify-between
    div
      h1.text-2xl.font-bold.text-white = t('.title')
      p.text-slate-400.mt-1 = t('.subtitle')

    = link_to new_admin_order_status_path, class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-white transition-all duration-200 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 shadow-lg shadow-emerald-500/25" do
      svg.w-5.h-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
        path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z"
      span.hidden.sm:inline = t('.new_status')

  .rounded-xl.border.overflow-hidden class="bg-slate-800/50 border-slate-700"
    .p-4.border-b class="border-slate-700"
      = render 'search', search_form: @presenter.search_form

    = render 'list', order_statuses: @presenter.ordered_order_statuses

