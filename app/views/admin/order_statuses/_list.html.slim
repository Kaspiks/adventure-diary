- if order_statuses.any?
  / Mobile card view
  .space-y-3.sm:hidden
    - order_statuses.each do |order_status|
      .rounded-lg.p-4.border class="bg-slate-700/50 border-slate-600"
        .flex.items-center.justify-between.gap-3
          div.min-w-0.flex-1
            .flex.items-center.gap-2.mb-1
              code.px-2.py-1.rounded.text-xs class="bg-slate-600" = order_status.code
              - if order_status.is_final
                span.inline-flex.items-center.px-2.py-0.5.rounded-full.text-xs.font-medium class="bg-emerald-500/20 text-emerald-300" = t('.headers.is_final')
            .text-sm.text-slate-300 = order_status.name

          = link_to edit_admin_order_status_path(order_status), class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-600 transition-colors" do
            svg.w-5.h-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
              path d="M5.433 13.917l1.262-3.155A4 4 0 017.58 9.42l6.92-6.918a2.121 2.121 0 013 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 01-.65-.65z"
              path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0010 3H4.75A2.75 2.75 0 002 5.75v9.5A2.75 2.75 0 004.75 18h9.5A2.75 2.75 0 0017 15.25V10a.75.75 0 00-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5z"

  / Desktop table view
  .hidden.sm:block
    table.w-full
      thead
        tr.border-b class="border-slate-700"
          th.px-6.py-4.text-left.text-sm.font-medium.text-slate-400 = t('.headers.code')
          th.px-6.py-4.text-left.text-sm.font-medium.text-slate-400 = t('.headers.name')
          th.px-6.py-4.text-left.text-sm.font-medium.text-slate-400 = t('.headers.is_final')
          th.px-6.py-4.text-right.text-sm.font-medium.text-slate-400 = t('.headers.actions')
      tbody.divide-y class="divide-slate-700"
        - order_statuses.each do |order_status|
          tr.transition-colors class="hover:bg-slate-700/50"
            td.px-6.py-4.font-medium.text-white
              code.px-2.py-1.rounded.text-xs class="bg-slate-700" = order_status.code
            td.px-6.py-4.text-slate-300 = order_status.name
            td.px-6.py-4
              - if order_status.is_final
                span.inline-flex.items-center.px-2.5.py-0.5.rounded-full.text-xs.font-medium class="bg-emerald-500/20 text-emerald-300" = t('.yes')
              - else
                span.inline-flex.items-center.px-2.5.py-0.5.rounded-full.text-xs.font-medium class="bg-slate-500/20 text-slate-400" = t('.no')
            td.px-6.py-4.text-right
              = link_to edit_admin_order_status_path(order_status), class: "inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm font-medium text-slate-300 transition-colors hover:text-white hover:bg-slate-700" do
                svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                  path d="M5.433 13.917l1.262-3.155A4 4 0 017.58 9.42l6.92-6.918a2.121 2.121 0 013 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 01-.65-.65z"
                  path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0010 3H4.75A2.75 2.75 0 002 5.75v9.5A2.75 2.75 0 004.75 18h9.5A2.75 2.75 0 0017 15.25V10a.75.75 0 00-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5z"
                = t('.actions.edit')

- else
  .p-8.text-center
    p.text-slate-400 = t('.no_records')
