- content_for :title, t('.title')

.space-y-6
  div
    h1.text-2xl.font-bold.text-white = t('.title')
    p.text-slate-400 = t('.subtitle', count: @presenter.total_count)

  / Orders List
  .rounded-xl.border.overflow-hidden class="bg-slate-800/50 border-slate-700"
    table.w-full
      thead
        tr.border-b class="border-slate-700"
          th.px-6.py-4.text-left.text-sm.font-medium.text-slate-400 = t('.headers.reward')
          th.px-6.py-4.text-left.text-sm.font-medium.text-slate-400 = t('.headers.buyer')
          th.px-6.py-4.text-left.text-sm.font-medium.text-slate-400 = t('.headers.points')
          th.px-6.py-4.text-left.text-sm.font-medium.text-slate-400 = t('.headers.status')
          th.px-6.py-4.text-left.text-sm.font-medium.text-slate-400 = t('.headers.ordered')
          th.px-6.py-4.text-right.text-sm.font-medium.text-slate-400 = t('.headers.actions')
      tbody.divide-y class="divide-slate-700"
        - if @presenter.decorated_orders.any?
          - @presenter.decorated_orders.each do |order|
            tr.transition-colors class="hover:bg-slate-700/50"
              td.px-6.py-4
                .font-medium.text-white = order.reward_title
              td.px-6.py-4
                .text-white = order.buyer_name
                .text-sm.text-slate-400 = order.buyer_email
              td.px-6.py-4.text-emerald-400.font-medium = order.points_display
              td.px-6.py-4
                span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-#{order.status_color}-500/20 text-#{order.status_color}-300"
                  = order.status_name
              td.px-6.py-4.text-slate-300 = order.ordered_at
              td.px-6.py-4.text-right
                .flex.items-center.justify-end.gap-2
                  = link_to admin_order_path(order), class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-700 transition-all", title: t('.actions.view') do
                    svg.w-5.h-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                      path d="M10 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z"
                      path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 010-1.186A10.004 10.004 0 0110 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0110 17c-4.257 0-7.893-2.66-9.336-6.41z" clip-rule="evenodd"
                  - if order.can_approve?
                    = button_to admin_orders_status_action_approve_path(order.id), method: :post, class: "px-3 py-1 rounded-lg text-xs font-medium text-blue-300 bg-blue-500/20 hover:bg-blue-500/30 transition-all cursor-pointer" do
                      = t('.actions.approve')
                  - if order.can_deliver?
                    = button_to admin_orders_status_action_deliver_path(order.id), method: :post, class: "px-3 py-1 rounded-lg text-xs font-medium text-emerald-300 bg-emerald-500/20 hover:bg-emerald-500/30 transition-all cursor-pointer" do
                      = t('.actions.deliver')
                  - if order.can_cancel?
                    = button_to admin_orders_status_action_cancel_path(order.id), method: :post, data: { turbo_confirm: t('.confirm_cancel') }, class: "px-3 py-1 rounded-lg text-xs font-medium text-red-300 bg-red-500/20 hover:bg-red-500/30 transition-all cursor-pointer" do
                      = t('.actions.cancel')
        - else
          tr
            td.px-6.py-12.text-center.text-slate-400 colspan="6"
              = t('.no_orders')

