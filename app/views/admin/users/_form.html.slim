= simple_form_for form, as: :admin_users_form, url: url, html: { class: "space-y-6" } do |f|
  - if form.errors.any?
    .rounded-xl.border.p-4 class="bg-red-500/10 border-red-500/30"
      .flex.items-start.gap-3
        svg.w-5.h-5.text-red-400.flex-shrink-0.mt-0.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
          path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"
        div
          p.font-medium.text-red-300 = t('errors.messages.not_saved', count: form.errors.count, resource: User.model_name.human.downcase)
          ul.mt-2.text-sm.text-red-300.space-y-1.list-disc.list-inside
            - form.errors.full_messages.each do |message|
              li = message

  .grid.gap-6 class="lg:grid-cols-3"
    .col-span-2.space-y-6
      .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
        h3.text-lg.font-semibold.text-white.mb-4 = t('.sections.basic_info')
        
        .grid.gap-4 class="sm:grid-cols-2"
          div
            = f.input :first_name,
              label: t('.first_name'),
              required: true,
              label_html: { class: "block text-sm font-medium text-slate-300 mb-1" },
              input_html: { class: "w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" }

          div
            = f.input :last_name,
              label: t('.last_name'),
              required: true,
              label_html: { class: "block text-sm font-medium text-slate-300 mb-1" },
              input_html: { class: "w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" }

        .mt-4
          = f.input :email,
            label: t('.email'),
            required: true,
            label_html: { class: "block text-sm font-medium text-slate-300 mb-1" },
            input_html: { class: "w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" }

      .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
        h3.text-lg.font-semibold.text-white.mb-4 = t('.sections.security')
        
        - unless form.object.persisted?
          p.text-sm.text-slate-400.mb-4 = t('.password_hint') if form.object.persisted?
        
        .grid.gap-4 class="sm:grid-cols-2"
          div
            = f.input :password,
              label: t('.password'),
              required: form.new_user?,
              label_html: { class: "block text-sm font-medium text-slate-300 mb-1" },
              input_html: { class: "w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent", autocomplete: "new-password" }

          div
            = f.input :password_confirmation,
              label: t('.password_confirmation'),
              required: form.new_user?,
              label_html: { class: "block text-sm font-medium text-slate-300 mb-1" },
              input_html: { class: "w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent", autocomplete: "new-password" }

        - if form.object.persisted?
          p.mt-2.text-sm.text-slate-400 = t('.password_hint')

    aside.space-y-6
      .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
        h3.text-lg.font-semibold.text-white.mb-4 = t('.sections.role')
        
        div
          = f.input :role_id,
            as: :select,
            collection: form.available_roles.map { |r| [r.name, r.id] },
            include_blank: t('.no_role'),
            label: t('.role'),
            label_html: { class: "block text-sm font-medium text-slate-300 mb-1" },
            input_html: { class: "w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" }
          p.text-xs.text-slate-400.mt-1 = t('.role_hint')

      .rounded-xl.border.p-6 class="bg-slate-800/50 border-slate-700"
        h3.text-lg.font-semibold.text-white.mb-4 = t('.sections.permissions')
        
        .space-y-4
          .flex.items-start.gap-3
            = f.check_box :admin, class: "mt-1 h-4 w-4 rounded text-emerald-500 border-slate-600 bg-slate-700 focus:ring-emerald-500 focus:ring-offset-slate-800"
            div
              = f.label :admin, t('.admin'), class: "text-sm font-medium text-slate-300"
              p.text-xs.text-slate-400 = t('.admin_hint')

          .flex.items-start.gap-3
            = f.check_box :blocked, class: "mt-1 h-4 w-4 rounded text-red-500 border-slate-600 bg-slate-700 focus:ring-red-500 focus:ring-offset-slate-800"
            div
              = f.label :blocked, t('.blocked'), class: "text-sm font-medium text-slate-300"
              p.text-xs.text-slate-400 = t('.blocked_hint')

      .flex.gap-3
        = f.submit (form.new_user? ? t('.submit_create') : t('.submit_update')), class: "flex-1 px-4 py-2 rounded-lg font-medium text-white cursor-pointer transition-all duration-200 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 shadow-lg shadow-emerald-500/25"
        = link_to t('.cancel'), admin_users_path, class: "px-4 py-2 rounded-lg font-medium text-slate-300 transition-colors hover:text-white hover:bg-slate-700"
