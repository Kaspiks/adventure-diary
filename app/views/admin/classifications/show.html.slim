.space-y-6
  .flex.items-center.justify-between
    div
      = link_to admin_classification_items_path, class: "inline-flex items-center gap-1 text-slate-400 hover:text-white transition-colors mb-2" do
        svg.w-4.h-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
          path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"
        = t('.back')
      h1.text-2xl.font-bold.text-white = @presenter.decorated_classification.title

    - if @presenter.can_edit?
      = link_to new_admin_classification_value_path(classification_id: @presenter.classification.id), class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-white transition-all duration-200 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 shadow-lg shadow-emerald-500/25" do
        svg.w-5.h-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
          path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-11.25a.75.75 0 00-1.5 0v2.5h-2.5a.75.75 0 000 1.5h2.5v2.5a.75.75 0 001.5 0v-2.5h2.5a.75.75 0 000-1.5h-2.5v-2.5z" clip-rule="evenodd"
        = t('.new_value')

  = render 'list', classification_values: @presenter.sorted_classification_values, can_edit: @presenter.can_edit?

